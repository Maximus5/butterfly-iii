<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/enabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:checked="true"
            android:text="@string/rule_field_enabled" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_label"
            app:expandedHintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/labelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_apps"
            app:expandedHintEnabled="false"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/appInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/patternLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/rule_field_pattern"
            app:endIconContentDescription="@string/rule_pick_existing_pattern"
            app:endIconDrawable="@drawable/ic_dropdown"
            app:endIconMode="custom"
            app:expandedHintEnabled="false"
            app:helperText="@string/rule_pattern_groups_hint"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/patternInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickMessageButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="12dp"
                android:text="@string/rule_pick_message" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/testAgainstHistoryButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:text="@string/rule_test" />

        </LinearLayout>

        <TextView
            android:id="@+id/availableMacrosText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/rule_section_accounts"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_kind"
            app:expandedHintEnabled="false"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/kindInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sourceAccountLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_source_account"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_insert_macro"
            app:endIconContentDescription="@string/rule_insert_macro">

            <io.github.maximus5.ffnotifyimporter.ui.SuggestAutoCompleteTextView
                android:id="@+id/sourceAccountInput"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:completionThreshold="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/destinationAccountLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_destination_account"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_insert_macro"
            app:endIconContentDescription="@string/rule_insert_macro">

            <io.github.maximus5.ffnotifyimporter.ui.SuggestAutoCompleteTextView
                android:id="@+id/destinationAccountInput"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:completionThreshold="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/accountApproximateSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/rule_field_account_approximate" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/rule_field_account_approximate_hint"
            android:textColor="#888888"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/amountManualSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/rule_field_amount_manual" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/rule_field_amount_manual_hint"
            android:textColor="#888888"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/homeCurrencyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_home_currency"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_dropdown"
            app:endIconContentDescription="@string/rule_pick_currency">

            <io.github.maximus5.ffnotifyimporter.ui.SuggestAutoCompleteTextView
                android:id="@+id/homeCurrencyInput"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:completionThreshold="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dateFormatLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_date_format"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_dropdown"
            app:endIconContentDescription="@string/rule_pick_date_format">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dateFormatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descriptionTemplateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_description_template"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_insert_macro"
            app:endIconContentDescription="@string/rule_insert_macro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/descriptionTemplateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/notesTemplateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_notes_template"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_insert_macro"
            app:endIconContentDescription="@string/rule_insert_macro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/notesTemplateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/categoryTemplateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_category_template"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_insert_macro"
            app:endIconContentDescription="@string/rule_insert_macro">

            <io.github.maximus5.ffnotifyimporter.ui.SuggestAutoCompleteTextView
                android:id="@+id/categoryTemplateInput"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tagsTemplateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/rule_field_tags_template"
            app:expandedHintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_insert_macro"
            app:endIconContentDescription="@string/rule_insert_macro">

            <io.github.maximus5.ffnotifyimporter.ui.TagsAutoCompleteTextView
                android:id="@+id/tagsTemplateInput"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
