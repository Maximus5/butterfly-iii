# Copy to keystore.properties (gitignored) and fill in. Never commit the real file.
# storeFile: absolute path to the upload keystore, kept outside the repository.
storeFile=C:/Users/<you>/keys/butterflyiii-upload.jks
storePassword=<keystore password>
keyAlias=upload
keyPassword=<key password>

# Optional, for ./gradlew publishReleaseBundle: absolute path to the Google Play service account's
# JSON key, kept outside the repository like the keystore.
playServiceAccountKey=C:/Users/<you>/keys/play-service-account.json
